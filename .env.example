# VPS runtime (keep existing .env values on upgrade)
APP_URL=https://doctorfizz-visibility.vercel.app
DATABASE_URL=postgresql://doctorfizz:CHANGE_ME@postgres:5432/doctorfizz
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379
IP_HASH_SALT=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TRUSTED_IP_HEADER=x-doctorfizz-proxy-ip
BACKEND_AUTH_REQUIRED=true
BACKEND_SHARED_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# On VPS leave empty. On Vercel use the HTTPS backend origin.
BACKEND_URL=
DOCTORFIZZ_WEB_PORT=8089
FREE_ATTEMPTS=5
WINDOW_DAYS=30
IP_DAILY_CAP=15
DOMAIN_DAILY_CAP=10
MAX_PENDING_CHECKS=1
# Disable any site that fails its VPS acceptance probe (comma-separated IDs).
BROWSER_DISABLED_PROVIDERS=
# Optional browser tuning (all safe to leave unset).
# Repair one selector after a site redesign without rebuilding, e.g.
#   BROWSER_SELECTOR_OVERRIDES={"duckai":{"answer":"div.reply"}}
BROWSER_SELECTOR_OVERRIDES=
# Acknowledge harmless welcome/terms/cookie notices (never sign-in/sign-up). Set false for strict stop-on-consent.
BROWSER_DISMISS_NOTICES=true
# Datacenter IPs are often refused; a proxy, BROWSER_HEADED=true (under xvfb-run) or BROWSER_USER_AGENT can help.
BROWSER_PROXY_SERVER=
BROWSER_PROXY_USERNAME=
BROWSER_PROXY_PASSWORD=
BROWSER_HEADED=false
BROWSER_USER_AGENT=
BROWSER_TIMEZONE=
HEALTH_CHECK_ENABLED=false
# Optional existing bot verification; no external credentials needed by default.
TURNSTILE_REQUIRED=false
